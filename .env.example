# ===== RuGo: переменные окружения =====
# Скопируйте в .env и заполните. Реальные значения не коммитить (.env в .gitignore).

# --- MAX-боты ---
# Токен основного бота (мини-приложение + приветствие)
MAX_BOT_TOKEN=
# Токен админ-бота (модерация заявок). Пусто — админ-модуль не опрашивает MAX
ADMIN_BOT_TOKEN=

# --- Доставка апдейтов MAX (longpoll | webhook) ---
# webhook — production-режим MAX; longpoll оставлен для отката.
MAX_DELIVERY_MODE=longpoll
ADMIN_DELIVERY_MODE=longpoll
# URL webhook. Пусто — ${PUBLIC_BASE_URL}/api/max/webhook и ${PUBLIC_BASE_URL}/admin/max/webhook
MAX_WEBHOOK_URL=
ADMIN_WEBHOOK_URL=
# Секреты webhook, [A-Za-z0-9_-]{5,256}. В режиме webhook обязательны.
MAX_WEBHOOK_SECRET=
ADMIN_WEBHOOK_SECRET=
# Период проверки/восстановления подписки, мс
MAX_WEBHOOK_CHECK_DELAY_MS=300000
ADMIN_WEBHOOK_CHECK_DELAY_MS=300000

# Администраторы хранятся в БД (таблица admins: MAX id + телефон). Токена веб-админки нет.
# Первого админа добавьте вне репозитория: см. sql/seed-admins.example.sql

# --- Админ-модуль ---
# Публичный базовый URL для абсолютных ссылок на фото в карточках админ-бота (напр. https://домен).
# Пусто — фото-вложения не прикрепляются
PUBLIC_BASE_URL=
# Порт веб-админки (по умолчанию 8081)
ADMIN_SERVER_PORT=8081
# Отправлять карточки заявок в чат админ-бота (по умолчанию false — работаем в веб-админке)
ADMIN_NOTIFY_CARDS=false
# Long-polling админ-бота: таймаут (сек) и лимит апдейтов
ADMIN_POLL_TIMEOUT=20
ADMIN_POLL_LIMIT=100
# Как часто сканировать новые заявки в БД, мс
ADMIN_LEADS_SCAN_DELAY_MS=10000
# Сколько последних строк лога отдавать командой /logs
ADMIN_LOGS_TAIL_LINES=300

# --- Внутренний вызов сброса кэша (rugo-admin → rugo-app) ---
# Случайная строка; пусто — сброс кэша выключен (TTL 2 мин всё равно подхватит)
INTERNAL_TOKEN=
# Базовый URL rugo-app для внутренних вызовов (по умолчанию loopback)
INTERNAL_BASE_URL=http://127.0.0.1:8080

# --- Сервер ---
# Адрес прослушивания (127.0.0.1 за Nginx; 0.0.0.0 — только если нет прокси)
SERVER_ADDRESS=127.0.0.1
# Каталог логов (используется logback и командой /logs)
LOG_DIR=logs

# --- Подключение к PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/rugo_db
DB_USER=rugo_user
DB_PASSWORD=

# --- Поведение приложения ---
# Засев демо-данных при пустой БД (по умолчанию false; true — только для dev)
APP_SEED_ENABLED=false
# Принимать заявки без проверенного initData (только dev/staging; прод — false)
ALLOW_ANON_LEADS=false
# Требовать подпись номера из requestContact (true на проде)
CONTACT_SIGNATURE_REQUIRED=true
# Время жизни initData, сек (документация MAX рекомендует 3600)
INIT_DATA_MAX_AGE_SECONDS=3600
# Срок годности подписи requestContact, сек (защита от повторного использования подписи)
CONTACT_SIGNATURE_MAX_AGE_SECONDS=600
# Загрузка фото техники партнёром (по умолчанию true). Выключить: false
PHOTO_UPLOADS_ENABLED=true
# Максимальный размер одного фото в байтах (по умолчанию 5 МБ)
PHOTO_MAX_BYTES=5242880

# --- Аналитика ---
# Соль для HMAC user_hash в аналитике (обязательна на проде; при пустой в prod старт падает)
ANALYTICS_SALT=

# --- Web / безопасность ---
# (опционально) Origin staging-фронтенда для CORS; в проде не нужен
WEBAPP_ORIGIN=
# Доверенные обратные прокси (через запятую). Только от них принимаем X-Forwarded-For/X-Real-IP
TRUSTED_PROXIES=127.0.0.1,::1

# --- Rate limit заявок (значения по умолчанию указаны рядом) ---
LEAD_PER_IP=10
LEAD_IP_WINDOW_SECONDS=3600
LEAD_PER_USER=5
LEAD_USER_WINDOW_SECONDS=3600
# Дедупликация заявок по телефону, мин (по умолчанию 10; 0 — выключена)
LEAD_DEDUP_MINUTES=10

# --- Лимиты приёма аналитики (/api/events) ---
# Максимум событий в одном батче
EVENTS_MAX_BATCH=50
# Максимальный размер тела запроса, байт
EVENTS_MAX_BODY_BYTES=32768
# Максимальный размер props одного события, байт
EVENTS_MAX_PROPS_BYTES=4096
# Лимит запросов /api/events с одного IP и окно (сек)
EVENTS_RATE_PER_IP=120
EVENTS_RATE_WINDOW_SECONDS=60
