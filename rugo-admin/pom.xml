<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ru.rugo</groupId>
        <artifactId>rugo</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>rugo-admin</artifactId>
    <name>RuGo Admin</name>

    <dependencies>
        <dependency>
            <groupId>ru.rugo</groupId>
            <artifactId>rugo-core</artifactId>
        </dependency>

        <!-- Веб-админка (отдельная страница в стиле MAX UI) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation на входных DTO (@Valid, @Size, @Pattern и т.д.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Healthcheck (/actuator/health), только локально -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- MAX Bot API: админ-бот (long-polling) и основной бот (уведомления партнёру) -->
        <dependency>
            <groupId>ru.etsft.max</groupId>
            <artifactId>max-bot-api-client</artifactId>
        </dependency>
        <dependency>
            <groupId>ru.etsft.max</groupId>
            <artifactId>max-bot-api-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
