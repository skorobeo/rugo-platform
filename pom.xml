<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.3</version>
    </parent>

    <groupId>ru.rugo</groupId>
    <artifactId>rugo</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>RuGo</name>

    <modules>
        <module>rugo-common</module>
        <module>rugo-core</module>
        <module>rugo-app</module>
        <module>rugo-admin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <max-bot-api.version>0.3.2</max-bot-api.version>
    </properties>

    <repositories>
        <repository>
            <id>github-max-bot</id>
            <url>https://maven.pkg.github.com/etsft/max-bot-api-java</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ru.rugo</groupId>
                <artifactId>rugo-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.rugo</groupId>
                <artifactId>rugo-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.etsft.max</groupId>
                <artifactId>max-bot-api-client</artifactId>
                <version>${max-bot-api.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.etsft.max</groupId>
                <artifactId>max-bot-api-jackson</artifactId>
                <version>${max-bot-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
